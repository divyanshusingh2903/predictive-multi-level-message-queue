{
  "version": "v2-prodflow-1",
  "frozen_on": "2026-10-05",
  "benchmark": "harbinger_prodflow",
  "seconds": 300,
  "workers": 4,
  "rate_scale": 1.8,
  "drain_s": 180,
  "seeds": [11, 22, 33, 44, 55],
  "arms": ["fifo", "static_tuned", "static_misconfigured", "shadow", "predictive", "predictive_producer", "oracle"],
  "primary_arm": "predictive",
  "short_classes": ["reserve_inventory", "push_notification", "reindex_product", "generate_invoice"],
  "long_class": "export_report",
  "bootstrap": {"samples": 10000, "seed": 2026, "confidence": 0.95},
  "criteria": {
    "P1_mean_latency_vs_fifo": {"metric": "mean_latency_ms", "baseline": "fifo", "max_relative_delta": -0.15},
    "P2_short_class_p50_vs_fifo": {"metric": "short_p50_ms", "baseline": "fifo", "max_relative_delta": -0.30},
    "G1_all_p99_vs_fifo": {"metric": "p99_latency_ms", "baseline": "fifo", "max_ratio": 1.25},
    "G2_long_class_max_wait": {"metric": "long_max_wait_ms", "baseline": "fifo", "max_ratio": 2.0, "absolute_max_ms": 60000},
    "G3_no_lost_work": {"completed_equals_submitted": true, "max_dlq": 0, "max_submit_errors": 0},
    "G4_throughput_vs_fifo": {"metric": "throughput_per_s", "baseline": "fifo", "min_ratio": 0.98},
    "S1_vs_static_tuned_noninferior": {"metric": "mean_latency_ms", "baseline": "static_tuned", "max_relative_delta": 0.10},
    "S2_beats_static_misconfigured": {"metric": "mean_latency_ms", "baseline": "static_misconfigured", "max_relative_delta": 0.0},
    "S3_shadow_overhead": {"metric": "mean_latency_ms", "baseline": "fifo", "arm": "shadow", "max_abs_relative_delta": 0.05,
                           "max_lookup_mean_us": 20},
    "S4_zero_config_vs_fifo": {"metric": "mean_latency_ms", "baseline": "fifo", "arm": "predictive_producer", "max_relative_delta": -0.05}
  },
  "gate": ["P1_mean_latency_vs_fifo", "P2_short_class_p50_vs_fifo", "G1_all_p99_vs_fifo", "G2_long_class_max_wait",
           "G3_no_lost_work", "G4_throughput_vs_fifo"]
}
