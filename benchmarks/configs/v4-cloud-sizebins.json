{
 "version": "v4-cloud-sizebins-1",
 "frozen_on": "2026-10-14",
 "issue": null,
 "preregistration": "docs/v4-cloud-reruns-preregistration.md",
 "replicates": "v3-sizebins-1",
 "environment": {
  "provider": "AWS us-east-1",
  "host": "c8i.2xlarge (8 vCPU, 16 GiB), Ubuntu 24.04, alone",
  "broker": "embedded in harbinger_prodflow over loopback, as in v3-cloud-e1",
  "image": "harbinger-bench built from the freeze commit",
  "runner": "benchmarks/run_prodflow.sh inside the image"
 },
 "benchmark": "harbinger_prodflow",
 "seconds": 300,
 "workers": 4,
 "rate_scale": 1.8,
 "drain_s": 180,
 "seeds": [
  11,
  22,
  33,
  44,
  55
 ],
 "arms": [
  "fifo",
  "predictive",
  "predictive_sized",
  "oracle"
 ],
 "primary_arm": "predictive_sized",
 "short_classes": [
  "reserve_inventory",
  "push_notification",
  "reindex_product",
  "generate_invoice"
 ],
 "long_class": "export_report",
 "sized_classes": [
  "resize_image",
  "generate_invoice",
  "export_report"
 ],
 "size_hint_header": "size_hint",
 "bootstrap": {
  "samples": 10000,
  "seed": 2026,
  "confidence": 0.95
 },
 "criteria": {
  "P1_mean_latency_vs_predictive": {
   "metric": "mean_latency_ms",
   "baseline": "predictive",
   "max_relative_delta": -0.03
  },
  "G1_all_p99_vs_predictive": {
   "metric": "p99_latency_ms",
   "baseline": "predictive",
   "max_ratio": 1.1
  },
  "G2_unsized_classes_vs_predictive": {
   "metric": "unsized_mean_ms",
   "baseline": "predictive",
   "max_relative_delta": 0.05
  },
  "G3_no_lost_work": {
   "completed_equals_submitted": true,
   "max_dlq": 0,
   "max_submit_errors": 0
  },
  "G4_long_class_max_wait_vs_fifo": {
   "metric": "long_max_wait_ms",
   "baseline": "fifo",
   "max_ratio": 2.0,
   "absolute_max_ms": 60000
  },
  "G5_throughput_vs_fifo": {
   "metric": "throughput_per_s",
   "baseline": "fifo",
   "min_ratio": 0.98
  },
  "S1_resize_mean_vs_predictive": {
   "metric": "class_mean_ms:resize_image",
   "baseline": "predictive",
   "max_relative_delta": -0.1
  },
  "S2_resize_shifted_mean_vs_predictive": {
   "metric": "shifted_class_mean_ms:resize_image",
   "baseline": "predictive",
   "max_relative_delta": -0.1
  },
  "S3_invoice_mean_vs_predictive": {
   "metric": "class_mean_ms:generate_invoice",
   "baseline": "predictive",
   "max_relative_delta": -0.1
  },
  "S4_sized_mean_vs_fifo": {
   "metric": "mean_latency_ms",
   "baseline": "fifo",
   "max_relative_delta": -0.15
  },
  "S5_predictive_replicates_v2": {
   "metric": "mean_latency_ms",
   "baseline": "fifo",
   "arm": "predictive",
   "max_relative_delta": -0.15
  }
 },
 "gate": [
  "P1_mean_latency_vs_predictive",
  "G1_all_p99_vs_predictive",
  "G2_unsized_classes_vs_predictive",
  "G3_no_lost_work",
  "G4_long_class_max_wait_vs_fifo",
  "G5_throughput_vs_fifo"
 ]
}
