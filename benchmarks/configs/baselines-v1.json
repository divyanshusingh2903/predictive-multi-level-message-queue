    {"name": "uniform-overload", "distribution": "uniform", "count": 200, "warmup": 20, "rate_per_s": 95, "workers": 1},
    {"name": "bimodal-low", "distribution": "bimodal", "count": 200, "warmup": 20, "rate_per_s": 88, "workers": 1},
    {"name": "bimodal-near", "distribution": "bimodal", "count": 200, "warmup": 20, "rate_per_s": 158, "workers": 1},
    {"name": "bimodal-overload", "distribution": "bimodal", "count": 200, "warmup": 20, "rate_per_s": 193, "workers": 1},
    {"name": "heavy-low", "distribution": "heavy_tail", "count": 200, "warmup": 20, "rate_per_s": 141, "workers": 1},
    {"name": "heavy-near", "distribution": "heavy_tail", "count": 200, "warmup": 20, "rate_per_s": 254, "workers": 1},
    {"name": "heavy-overload", "distribution": "heavy_tail", "count": 200, "warmup": 20, "rate_per_s": 310, "workers": 1},
    {"name": "bimodal-control", "distribution": "bimodal", "count": 200, "warmup": 20, "rate_per_s": 158, "workers": 1, "informative": false},
    {"name": "heavy-shift", "distribution": "heavy_tail", "count": 200, "warmup": 20, "rate_per_s": 254, "workers": 1, "shift_index": 100},
    {"name": "uniform-cold", "distribution": "uniform", "count": 200, "warmup": 0, "rate_per_s": 77, "workers": 1},
    {"name": "bimodal-four-workers", "distribution": "bimodal", "count": 200, "warmup": 20, "rate_per_s": 350, "workers": 4},
    {"name": "bimodal-aging-off", "distribution": "bimodal", "count": 200, "warmup": 20, "rate_per_s": 158, "workers": 1,
