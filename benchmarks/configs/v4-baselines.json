{
 "version": "v4-baselines-1",
 "frozen_on": null,
 "issue": null,
 "preregistration": "docs/v4-baselines-preregistration.md",
 "workload": "v2-prodflow-1, unchanged",
 "environment": {
  "provider": "AWS us-east-1",
  "host": "c8i.2xlarge (8 vCPU, 16 GiB), Ubuntu 24.04, alone",
  "broker": "embedded in harbinger_prodflow over loopback, as in v3-cloud-e1",
  "image": "harbinger-bench built from the freeze commit",
  "runner": "benchmarks/run_prodflow.sh inside the image"
 },
 "benchmark": "harbinger_prodflow",
 "seconds": 300,
 "workers": 4,
 "rate_scale": 1.8,
 "drain_s": 180,
 "seeds": [
  11,
  22,
  33,
  44,
  55,
  66,
  77,
  88,
  99,
  110
 ],
 "arms": [
  "fifo",
  "predictive",
  "static_tuned",
  "predictive_mean",
  "predictive_p75",
  "per_type_fair",
  "predictive_noaging",
  "ablate_decay",
  "ablate_spread",
  "ablate_stale",
  "ablate_nmin"
 ],
 "primary_arm": "predictive",
 "short_classes": [
  "reserve_inventory",
  "push_notification",
  "reindex_product",
  "generate_invoice"
 ],
 "long_class": "export_report",
 "phase_metrics": true,
 "bootstrap": {
  "samples": 10000,
  "seed": 2026,
  "confidence": 0.95
 },
 "gate": [],
 "criteria": {
  "B1_predictive_vs_per_type_fair": {
   "arm": "predictive",
   "baseline": "per_type_fair",
   "metric": "mean_latency_ms",
   "reading": {
    "margin": 0.03,
    "labels": {
     "up": "predictive worse",
     "tied": "tied",
     "down": "predictive better"
    }
   }
  },
  "B2_predictive_vs_static_tuned": {
   "arm": "predictive",
   "baseline": "static_tuned",
   "metric": "mean_latency_ms",
   "reading": {
    "margin": 0.03,
    "labels": {
     "up": "predictive worse",
     "tied": "tied",
     "down": "predictive better"
    }
   }
  },
  "B3_predictive_mean_vs_predictive": {
   "arm": "predictive_mean",
   "baseline": "predictive",
   "metric": "mean_latency_ms",
   "reading": {
    "margin": 0.03,
    "labels": {
     "up": "variant worse",
     "tied": "tied",
     "down": "variant better"
