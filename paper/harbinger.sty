% Light Harbinger theme for the preprint: logo in the title block, brand ink/slate colours.
% Brand values from assets/brand/README.md. Signal orange is reserved for the logo dot.
\ProvidesPackage{harbinger}[2026/10/13 Harbinger preprint theme]
\RequirePackage[table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}

\definecolor{hbink}{HTML}{15171C}
\definecolor{hbslate}{HTML}{5B616E}
\definecolor{hbsignal}{HTML}{E4572E}

\titleformat{\section}{\normalfont\Large\bfseries\color{hbink}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\color{hbink}}{\thesubsection}{0.8em}{}

% Booktabs rules in slate.
\AtBeginEnvironment{tabular}{\arrayrulecolor{hbslate}}
\setlength{\heavyrulewidth}{0.08em}

% Running header: wordmark-free, just the short title and page number in slate.
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\color{hbslate}\small\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\color{hbslate}\small\thepage}}

% Title block: lockup, title, author, project line, and a slate rule.
\newcommand{\harbingertitle}[4]{% title, author, date, project url
  \begin{center}
    \includegraphics[height=2.4em]{figures/harbinger-lockup.pdf}\par\vspace{1.4em}
    {\LARGE\bfseries\color{hbink}#1\par}\vspace{1em}
    {\large\color{hbink}#2\par}\vspace{0.3em}
    {\small\color{hbslate}#3 \quad $\cdot$ \quad #4\par}\vspace{0.6em}
    {\color{hbslate}\rule{\linewidth}{0.4pt}}
  \end{center}\vspace{0.4em}}
